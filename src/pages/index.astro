---
import Layout from '../layouts/Site.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Home">
   <!-- TODO: FIX LOGO HOVER -->
   <p>This is the <b>Axeon Network</b>. We run small community-oriented spaces and projects.</p>
   <p><Icon name="discord" /> <b>To join the Discord Server, <a href="/discord">click here</a>!</b> Otherwise, read on to explore more.</p>
   <hr>
   <h2 class="head">Check out...</h2>
   <div class="grid">
      <div class="grid vertical">
         <Icon name="material-symbols:book-ribbon-outline-rounded" />
         <h3>KuroWiki</h3>
         <div class="grid horizontal">
            <a class="button" href="/kurowiki">Visit</a>
            <a class="button" href="https://github.com/Axeon-Network/kurowiki">Source Code</a>
         </div>
      </div>
   </div>
</Layout>
