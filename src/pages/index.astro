---
import Layout from '../layouts/Site.astro';
import { Icon } from 'astro-icon/components';
import { cfg } from "../config";
import pkg from '../../package.json';
---

<Layout title="Home">
   <p>This is the <b>Axeon Network</b>. We run small community-oriented spaces and projects.</p>
   <p><b><Icon name="discord" /> To join the Discord Server, <a href="/discord">click here</a>!</b> Otherwise, read on to explore more.</p>
   <hr>
   <h2 class="head">Check out...</h2>
   <div class="grid">
      <div class="grid vertical">
         <div class="project-img"><img src="https://axeon-network.github.io/kurowiki/res/img/favicon.png"></div>
         <h3>KuroWiki</h3>
         <div class="grid vertical">
            <a class="button" href="/kurowiki">Visit</a>
            <a class="button sm" href="https://github.com/Axeon-Network/kurowiki">Source Code</a>
         </div>
      </div>
   </div>
   <hr>
   <div class="footer">
    <h4>Add our 88x31 button!</h4>
    <img src="/img/8831/axeon.png" alt="Axeon Network button" class="button8831" title="Click to copy the HTML code!" data-copy=`&lt;a href="http://${cfg.domain}"&gt;&lt;img src="http://${cfg.domain}/img/8831/axeon.png"&gt;` style="cursor:pointer;">
    <script>
      document.querySelectorAll('.button8831').forEach(btn => {
         const element = btn as HTMLElement;
         element.addEventListener('click', () => {
            const text = (element.dataset.copy || "")
                .replaceAll("&lt;", "<")
                .replaceAll("&gt;", ">");
            navigator.clipboard.writeText(text)
         });
      });
    </script>
    <br>
    <div><b>© {cfg.copyrightyear} {cfg.name}</b></div>
    <br>
    <details>
        <summary>Show site info</summary>
        <div><b><a href={cfg.sourcecode}>{pkg.name}</a></b></div>
        <div>Source code of this website is licensed under <a href={cfg.licenseurl}>{cfg.license}</a></div>
        <div>Website designed with 💜 by <a href="https://avery.is-a.dev">avyneko</a>!</div>
        <div>Wordmark designed by <a href="https://github.com/marshallkitblep">KitSixtyFour</a></div>
    </details>
    <noscript><br><i>[!] JavaScript is disabled, some website functionality may be limited [!]</i></noscript>
</div>
</Layout>
